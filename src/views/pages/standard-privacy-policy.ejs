<%- include('../partials/head', { seo }) %>
<%- include('../partials/header') %>

<main class="container section legal">
  <div class="legal-top">
    <div>
      <p class="eyebrow"><%= policy.businessName %></p>
      <h1><%= policy.title %></h1>
      <p>Vigencia: <%= policy.effectiveDate %> · Versión: <%= policy.version %> · Última actualización: <%= policy.lastUpdated %></p>
    </div>
    <button id="print-policy-button" class="btn btn-secondary" type="button">Imprimir / Guardar PDF</button>
  </div>

  <nav class="card" aria-label="Índice de la política">
    <ol>
      <% policy.sections.forEach((section) => { %>
      <li><a href="#<%= section.id %>"><%= section.title %></a></li>
      <% }) %>
    </ol>
  </nav>

  <section id="responsable" class="card">
    <h2>Responsable del tratamiento</h2>
    <p><strong>Nombre:</strong> <%= policy.dataController.name %></p>
    <p><strong>Rol:</strong> <%= policy.dataController.role %></p>
    <p><strong>Correo:</strong> <%= policy.dataController.email %></p>
    <p><strong>Dirección:</strong> <%= policy.dataController.location %></p>
    <p><strong>Teléfono:</strong> <%= policy.dataController.phone %></p>
  </section>

  <% policy.sections.forEach((section) => { %>
  <section id="<%= section.id %>" class="card">
    <h2><%= section.title %></h2>
    <% if (section.paragraphs) { section.paragraphs.forEach((paragraph) => { %>
    <p><%= paragraph %></p>
    <% }) } %>
    <% if (section.items) { %>
    <ul>
      <% section.items.forEach((item) => { %>
      <li><%= item %></li>
      <% }) %>
    </ul>
    <% } %>
  </section>
  <% }) %>

  <p><a class="link" href="/privacidad">← Volver al centro de privacidad</a></p>
</main>

<%- include('../partials/footer') %>
